{
  "schema_version": 1,
  "last_updated": "2026-09-05",
  "enums": {
    "evidence_severity": ["CRITICAL", "HIGH", "MEDIUM"],
    "quality_signal": ["IMPLEMENTATION", "INFRA", "SECURITY", "EVIDENCE", "MIXED"]

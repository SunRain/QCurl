  "entries": {
    "artifacts_schema": {
      "source": "libcurl_consistency",
      "evidence_severity": "CRITICAL",
      "quality_signal": "EVIDENCE",
      "meaning": "artifacts schema/version 不符合 qcurl-lc/artifacts@v1 或 required 字段缺失（避免字段漂移导致误判）。",
      "where_to_check": [
        "build/libcurl_consistency/reports/gate_<suite>.json: postflight_artifacts_schema_check.violations",
        "curl/tests/http/gen/artifacts/**/{baseline,qcurl}.json"
      ]
    },
    "env_preflight_httpbin_env_missing": {
      "source": "uce",
      "evidence_severity": "CRITICAL",
      "quality_signal": "EVIDENCE",
      "meaning": "httpbin 启动命令返回成功，但未生成 httpbin.env（证据链断裂）。",
      "where_to_check": [
        "build/evidence/uce/<run-id>/logs/httpbin_start.log",
        "build/evidence/uce/<run-id>/httpbin/httpbin.env（缺失）"
      ]
    },
    "env_preflight_httpbin_env_parse_error": {
      "source": "uce",
      "evidence_severity": "CRITICAL",
      "quality_signal": "EVIDENCE",
      "meaning": "httpbin.env 存在但解析失败（无法获得 QCURL_HTTPBIN_URL 等关键环境）。",
      "where_to_check": [
        "build/evidence/uce/<run-id>/httpbin/httpbin_env_parse_error.txt",
        "build/evidence/uce/<run-id>/httpbin/httpbin.env"
      ]
    },
    "env_preflight_httpbin_start_failed": {
      "source": "uce",
      "evidence_severity": "CRITICAL",
      "quality_signal": "INFRA",
      "meaning": "httpbin 启动失败（Docker 权限/镜像/端口/健康检查失败等）。",
      "where_to_check": ["build/evidence/uce/<run-id>/logs/httpbin_start.log"]
    },
    "env_preflight_httpbin_url_missing": {
      "source": "uce",
      "evidence_severity": "CRITICAL",
      "quality_signal": "EVIDENCE",

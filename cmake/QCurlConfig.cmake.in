@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Qt6 REQUIRED COMPONENTS Core)
if("OtherExtras" IN_LIST QCurl_FIND_COMPONENTS)
    find_dependency(Qt6 REQUIRED COMPONENTS Network)
endif()
if(NOT @QCURL_BUILD_SHARED_LIBS@ AND NOT @QCURL_BUILD_LIBCURL_CONSISTENCY@)
    find_dependency(CURL @QCURL_MIN_LIBCURL_VERSION@ REQUIRED)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/QCurlTargets.cmake")

set(QCurl_Core_FOUND TRUE)
set(QCurl_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@/qcurl")
set(QCurl_BLOCKING_EXTRAS_INCLUDE_DIR "${QCurl_INCLUDE_DIR}")
set(QCurl_TEST_SUPPORT_INCLUDE_DIR "${QCurl_INCLUDE_DIR}")
set(QCurl_OTHER_EXTRAS_INCLUDE_DIR "${QCurl_INCLUDE_DIR}")
set(QCurl_OTHER_EXTRAS_WEBSOCKET_AVAILABLE @QCURL_WEBSOCKET_SUPPORT@)

foreach(_qcurl_component IN LISTS QCurl_FIND_COMPONENTS)
    if(_qcurl_component STREQUAL "Core")
        set(QCurl_Core_FOUND TRUE)
    elseif(_qcurl_component STREQUAL "BlockingExtras")
        include("${CMAKE_CURRENT_LIST_DIR}/QCurlBlockingExtrasTargets.cmake" OPTIONAL)
        if(TARGET QCurl::BlockingExtras
           AND EXISTS "${QCurl_INCLUDE_DIR}/QCBlockingNetworkClient.h"
           AND EXISTS "${QCurl_INCLUDE_DIR}/QCBlockingNetworkResult.h")
            set(QCurl_BlockingExtras_FOUND TRUE)
        else()
            set(QCurl_BlockingExtras_FOUND FALSE)
        endif()
    elseif(_qcurl_component STREQUAL "TestSupport")
        include("${CMAKE_CURRENT_LIST_DIR}/QCurlTestSupportTargets.cmake" OPTIONAL)
        if(TARGET QCurl::TestSupport
           AND EXISTS "${QCurl_INCLUDE_DIR}/QCNetworkMockHandler.h"
           AND EXISTS "${QCurl_INCLUDE_DIR}/QCNetworkTestSupport.h")
            set(QCurl_TestSupport_FOUND TRUE)
        else()
            set(QCurl_TestSupport_FOUND FALSE)
        endif()
    elseif(_qcurl_component STREQUAL "OtherExtras")
        include("${CMAKE_CURRENT_LIST_DIR}/QCurlOtherExtrasTargets.cmake" OPTIONAL)
        if(TARGET QCurl::OtherExtras
           AND EXISTS "${QCurl_INCLUDE_DIR}/QCNetworkDiagnostics.h"
           AND EXISTS "${QCurl_INCLUDE_DIR}/QCNetworkMiddlewareExtras.h")
            set(QCurl_OtherExtras_FOUND TRUE)
        else()
            set(QCurl_OtherExtras_FOUND FALSE)
        endif()
    else()
        set(QCurl_${_qcurl_component}_FOUND FALSE)
    endif()
endforeach()

check_required_components(QCurl)
